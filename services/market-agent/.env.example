# .env.example - copy to .env for local development. Do not commit real keys.
OTEL_SERVICE_NAME=market-agent
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.version=0.1.0
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_always_on
LLM_GATEWAY_BASE_URL=http://localhost:4000/v1
LLM_GATEWAY_API_KEY=
LLM_MODEL_ROUTE=market-standard

EXA_API_KEY=
EXA_MAX_RESULTS=8
EXA_CONTENT_MAX_CHARACTERS=4000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1800
