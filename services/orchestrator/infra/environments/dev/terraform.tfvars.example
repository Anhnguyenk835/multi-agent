project_id = "replace-with-your-gcp-project-id"
region     = "asia-southeast1"

image = "asia-southeast1-docker.pkg.dev/replace-with-your-gcp-project-id/orchestrator/orchestrator:dev"

# Fill these in with the `url` output from each downstream service's own
# `terraform apply`, run first.
researcher_url    = "https://researcher-xxxxxxxxxx.asia-southeast1.run.app"
market_agent_url  = "https://market-agent-xxxxxxxxxx.asia-southeast1.run.app"
analyst_url        = "https://analyst-xxxxxxxxxx.asia-southeast1.run.app"
writer_url         = "https://writer-xxxxxxxxxx.asia-southeast1.run.app"

allowed_origins = "*"
