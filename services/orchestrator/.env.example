# .env.example - copy to .env for local development. Do not commit real keys.
OTEL_SERVICE_NAME=orchestrator
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.version=0.1.0
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/ready
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_always_on
